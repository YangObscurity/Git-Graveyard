{
  "version": "v1",
  "hooks": [
    {
      "name": "rules-props",
      "trigger": "PostFileSave",
      "matcher": "lib/rules/.*\\.ts$",
      "action": {
        "type": "command",
        "command": "npm run test:props"
      }
    },
    {
      "name": "task-golden",
      "trigger": "PostTaskExec",
      "action": {
        "type": "command",
        "command": "npm run test:golden"
      }
    },
    {
      "name": "guard-paths",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/guard-paths.mjs"
      }
    }
  ]
}
